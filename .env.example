# -------  Storage  -------

EXTERNAL_DISK_PATH=/mnt/external  # host path mounted into store-api as the users' storage root

# -------  Auth  -------

AUTH_SERVICE_URL=http://auth:8000  # tpcloud's auth service — must be reachable on the shared
                                    # `tpcloud_gateway` Docker network (tpcloud has to be running)
